// Project Honjin (本陣) - DBML Schema
// ゼロトラスト × 労務管理 データベース構造

Project Honjin {
database_type: 'PostgreSQL'
Note: '洋上プラント構想に基づくコアバックエンドDB'
}

// -------------------------------------------------------------------------
// Organizations (組織情報)
// -------------------------------------------------------------------------
Table companies {
id bigint \[pk, increment\]
public_id uuid \[unique, not null\]
company_code varchar \[unique, not null\]
name varchar \[not null\]
name_en varchar
timezone varchar \[default: 'Asia/Tokyo'\]
work_start_time time
work_end_time time
created_at timestamp \[not null\]
updated_at timestamp
}

Table departments {
id bigint \[pk, increment\]
public_id uuid \[unique, not null\]
company_id bigint \[not null\]
department_code varchar \[not null\]
name varchar \[not null\]
name_en varchar
timezone varchar
work_start_time time
work_end_time time
created_at timestamp \[not null\]
updated_at timestamp
}

// -------------------------------------------------------------------------
// Personals (ユーザー個人情報: PII保護)
// -------------------------------------------------------------------------
Table personals {
id bigint \[pk, increment\]
public_id uuid \[unique, not null\]
company_id bigint
department_id bigint
employee_code varchar

sei_encrypted varchar
mei_encrypted varchar
sei_en_encrypted varchar
mei_en_encrypted varchar

sei_kana_encrypted varchar
sei_kana_bidx varchar
mei_kana_encrypted varchar
mei_kana_bidx varchar
tel_encrypted varchar
tel_bidx varchar

email_encrypted varchar
email_bidx varchar \[unique\]

mobile_tel_encrypted varchar
mobile_tel_bidx varchar
mobile_email_encrypted varchar
mobile_email_bidx varchar \[unique\]

pii_key_version int \[default: 1\]
created_at timestamp \[not null\]
updated_at timestamp
deleted_at timestamp
}

// -------------------------------------------------------------------------
// Authentication, Security & Devices
// -------------------------------------------------------------------------
Table accounts {
id bigint \[pk, increment\]
personal_id bigint \[not null\]
provider varchar
provider_account_id varchar
password_hash varchar
emergency_bypass_enabled boolean \[default: false\]
created_at timestamp \[not null\]
updated_at timestamp
}

Table registered_devices {
id bigint \[pk, increment\]
personal_id bigint \[not null\]
device_token varchar \[unique, not null, note: 'LocalStorageに保存する識別子'\]
user_agent varchar
last_login_at timestamp \[not null\]
created_at timestamp \[not null\]
}

Table sessions {
id bigint \[pk, increment\]
personal_id bigint \[not null\]
session_token varchar \[unique, not null\]
expires_at timestamp \[not null\]
is_active boolean \[default: true\]
created_at timestamp \[not null\]
}

// -------------------------------------------------------------------------
// Workflows & Auditing
// -------------------------------------------------------------------------
Table overtime_requests {
id bigint \[pk, increment\]
personal_id bigint \[not null\]
target_date date \[not null\]
start_time time \[not null\]
end_time time \[not null\]
reason varchar \[not null\]
status varchar \[default: 'pending', note: 'pending, approved, rejected'\]
created_at timestamp \[not null\]
updated_at timestamp
}

Table audit_logs {
id bigint \[pk, increment\]
personal_id bigint
action varchar \[not null\]
ip_address varchar
user_agent varchar
details varchar \[note: 'JSON string'\]
created_at timestamp \[not null\]
}

// -------------------------------------------------------------------------
// Relationships
// -------------------------------------------------------------------------
Ref: departments.company_id > companies.id
Ref: personals.company_id > companies.id
Ref: personals.department_id > departments.id

Ref: accounts.personal_id > personals.id
Ref: registered_devices.personal_id > personals.id
Ref: sessions.personal_id > personals.id
Ref: overtime_requests.personal_id > personals.id
Ref: audit_logs.personal_id > personals.id